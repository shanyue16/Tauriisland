{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "default permissions for tauriisland",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-current-monitor",
    "core:webview:default",
    "core:tray:default",
    "autostart:default",
    "store:default",
    "http:default",
    "notification:default",
    {
      "identifier": "http:allow-fetch",
      "allow": [
        { "url": "https://uapis.cn/*" },
        { "url": "https://lrclib.net/*" },
        { "url": "https://itunes.apple.com/*" },
        { "url": "http://mobilecdn.kugou.com/*" },
        { "url": "https://lyrics.kugou.com/*" },
        { "url": "https://imge.kugou.com/*" },
        { "url": "https://music.163.com/*" },
        { "url": "https://interface3.music.163.com/*" },
        { "url": "https://u.y.qq.com/*" },
        { "url": "https://c.y.qq.com/*" },
        { "url": "https://y.qq.com/*" },
        { "url": "https://shc.y.qq.com/*" },

        { "url": "http://127.0.0.1:32109/*" },
        { "url": "http://127.0.0.1:32107/*" },
        { "url": "http://127.0.0.1:9863/*" },
        { "url": "http://127.0.0.1:8765/*" },
        { "url": "http://127.0.0.1:*/*" },
        { "url": "http://localhost:*/*" }
      ]
    }
  ]
}
